{
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "krea2_raw_bf16.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen3vl_4b_fp8_scaled.safetensors", "type": "krea2", "device": "default" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "qwen_image_vae.safetensors" }
  },
  "4": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["1", 0],
      "lora_name": "krea2_style_reference.safetensors",
      "strength_model": 1.0
    }
  },
  "5": {
    "class_type": "ModelSamplingFlux",
    "inputs": {
      "max_shift": 1.15,
      "base_shift": 0.5,
      "width": "%width%",
      "height": "%height%",
      "model": ["4", 0]
    }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": { "image": "%reference_image%" }
  },
  "11": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "inputs": {
      "prompt": "%prompt%",
      "clip": ["2", 0],
      "vae": ["3", 0],
      "image1": ["10", 0]
    }
  },
  "12": {
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "inputs": {
      "reference_latents_method": "index_timestep_zero",
      "conditioning": ["11", 0]
    }
  },
  "13": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": ["12", 0]
    }
  },
  "14": {
    "class_type": "CFGGuider",
    "inputs": {
      "cfg": "%cfg%",
      "model": ["5", 0],
      "positive": ["12", 0],
      "negative": ["13", 0]
    }
  },
  "15": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": "%seed%" }
  },
  "16": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "euler" }
  },
  "17": {
    "class_type": "BasicScheduler",
    "inputs": {
      "scheduler": "simple",
      "steps": "%steps%",
      "denoise": 1.0,
      "model": ["5", 0]
    }
  },
  "18": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": "%width%", "height": "%height%", "batch_size": 1 }
  },
  "19": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["15", 0],
      "guider": ["14", 0],
      "sampler": ["16", 0],
      "sigmas": ["17", 0],
      "latent_image": ["18", 0]
    }
  },
  "20": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["19", 0], "vae": ["3", 0] }
  },
  "21": {
    "class_type": "PreviewImage",
    "inputs": { "images": ["20", 0] }
  }
}
